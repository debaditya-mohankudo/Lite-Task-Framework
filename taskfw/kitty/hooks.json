{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${KITTY_TASKFW_PYTHON}\" -m taskfw.kitty.hook",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${KITTY_TASKFW_PYTHON}\" -m taskfw.kitty.hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${KITTY_TASKFW_PYTHON}\" -m taskfw.kitty.hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${KITTY_TASKFW_PYTHON}\" -m taskfw.kitty.hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${KITTY_TASKFW_PYTHON}\" -m taskfw.kitty.hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}